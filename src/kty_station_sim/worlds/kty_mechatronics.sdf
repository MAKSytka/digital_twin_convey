<?xml version="1.0"?>
<sdf version="1.10">
  <world name="kty_mechatronics">
    <gravity>0 0 -9.81</gravity>
    <physics name="kty_mechatronics_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.48 0.48 0.48</ambient>
      <background>0.13 0.15 0.19</background>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <pose>-3 -4 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>0.3 0.4 -1.0</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="floor">
        <collision name="collision"><geometry><box><size>6.0 3.0 0.10</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.0 3.0 0.10</size></box></geometry><material><ambient>0.17 0.18 0.20 1</ambient><diffuse>0.24 0.25 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <model name="kty_mechatronics_machine">
      <self_collide>false</self_collide>
      <link name="base">
        <pose>0 0 0.22 0 0 0</pose>
        <inertial><mass>200</mass><inertia><ixx>30</ixx><iyy>80</iyy><izz>100</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="frame"><geometry><box><size>4.20 0.70 0.16</size></box></geometry></collision>
        <visual name="frame_visual"><geometry><box><size>4.20 0.70 0.16</size></box></geometry><material><ambient>0.10 0.12 0.15 1</ambient><diffuse>0.18 0.21 0.25 1</diffuse></material></visual>
      </link>
      <joint name="base_world_fixed" type="fixed"><parent>world</parent><child>base</child></joint>

      <link name="vibration_deck">
        <pose>0 0 0.405 0 0 0</pose>
        <inertial><mass>35</mass><inertia><ixx>1.8</ixx><iyy>2.4</iyy><izz>3.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="deck"><geometry><box><size>0.78 0.62 0.10</size></box></geometry></collision>
        <visual name="deck_visual"><geometry><box><size>0.78 0.62 0.10</size></box></geometry><material><ambient>0.08 0.10 0.13 1</ambient><diffuse>0.15 0.19 0.24 1</diffuse></material></visual>
      </link>
      <joint name="vibration_joint" type="prismatic">
        <parent>base</parent><child>vibration_deck</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-0.004</lower><upper>0.004</upper><effort>8000</effort><velocity>1.5</velocity></limit><dynamics><damping>180</damping><friction>10</friction></dynamics></axis>
      </joint>

      <link name="infeed_roller_01"><pose>-1.850 0 0.465 1.57079632679 0 0</pose><inertial><mass>0.45</mass><inertia><ixx>0.0105</ixx><iyy>0.00030</iyy><izz>0.0105</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.035</radius><length>0.52</length></cylinder></geometry><surface><friction><ode><mu>1.20</mu><mu2>0.90</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction><bounce><restitution_coefficient>0.01</restitution_coefficient><threshold>0.2</threshold></bounce><contact><ode><kp>8000000</kp><kd>180</kd><max_vel>0.05</max_vel><min_depth>0.0002</min_depth></ode></contact></surface></collision><visual name="visual"><geometry><cylinder><radius>0.035</radius><length>0.52</length></cylinder></geometry><material><ambient>0.19 0.22 0.25 1</ambient><diffuse>0.34 0.38 0.42 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual></link>
