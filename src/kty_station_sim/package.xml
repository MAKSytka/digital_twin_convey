<?xml version="1.0"?>
<package format="3">
  <name>kty_station_sim</name>
  <version>0.1.0</version>
  <description>Simplified Gazebo digital twin of the KTY handling and vibration-compaction station.</description>
  <maintainer email="team@example.com">Singulator Team</maintainer>
  <license>Apache-2.0</license>

  <!--
    The package uses the ament_python build type declared below.  We do not
    list ament_python as a rosdep dependency because this workspace targets a
    ROS 2 Jazzy installation where the local rosdep database may not expose an
    ament_python key.  The build type is provided by the sourced ROS setup.
  -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>singulator_interfaces</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
