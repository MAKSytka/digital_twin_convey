<?xml version="1.0"?>
<package format="3">
  <name>kty_conveyor_surface</name>
  <version>0.1.0</version>
  <description>Gazebo system plugin that drives KTY containers over flat conveyor contact zones.</description>
  <maintainer email="team@example.com">Singulator Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!--
    ROS dependency resolution must use the Jazzy vendor packages.  The
    versioned CMake packages (gz-sim8, gz-plugin2, gz-transport13 and
    gz-msgs10) are provided by these vendors, but are not valid rosdep keys.
  -->
  <build_depend>gz_sim_vendor</build_depend>
  <build_depend>gz_plugin_vendor</build_depend>
  <build_depend>gz_transport_vendor</build_depend>
  <build_depend>gz_msgs_vendor</build_depend>

  <exec_depend>gz_sim_vendor</exec_depend>
  <exec_depend>gz_plugin_vendor</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
