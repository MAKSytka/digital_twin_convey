<?xml version="1.0"?>
<package format="3">
  <name>kty_conveyor_surface</name>
  <version>0.1.0</version>
  <description>Gazebo system plugin that drives KTY containers over flat conveyor contact zones.</description>
  <maintainer email="team@example.com">Singulator Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>gz-sim8</build_depend>
  <build_depend>gz-plugin2</build_depend>
  <build_depend>gz-transport13</build_depend>
  <build_depend>gz-msgs10</build_depend>

  <exec_depend>gz-sim8</exec_depend>
  <exec_depend>gz-plugin2</exec_depend>
  <exec_depend>gz-transport13</exec_depend>
  <exec_depend>gz-msgs10</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
