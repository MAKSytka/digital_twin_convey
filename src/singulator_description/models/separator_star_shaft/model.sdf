<?xml version="1.0"?>
<sdf version="1.10">
  <model name="separator_star_shaft">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base">
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>4.2</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.002</iyy><iyz>0</iyz><izz>4.2</izz>
        </inertia>
      </inertial>
      <visual name="left_bearing">
        <pose>0 -1.245 0.055 0 0 0</pose>
        <geometry><box><size>0.080 0.040 0.100</size></box></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
      </visual>
      <visual name="right_bearing">
        <pose>0 1.245 0.055 0 0 0</pose>
        <geometry><box><size>0.080 0.040 0.100</size></box></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor">
      <pose>0 0 0.055 0 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>6.16</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.004</iyy><iyz>0</iyz><izz>6.16</izz>
        </inertia>
      </inertial>

      <!-- One continuous transverse roller replaces the former 25-disc row. -->
      <collision name="roller_collision">
        <pose>0 0 0 1.570796327 0 0</pose>
        <max_contacts>24</max_contacts>
        <geometry>
          <cylinder><radius>0.025</radius><length>2.480</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.10</mu><mu2>0.85</mu2><fdir1>1 0 0</fdir1></ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1000</threshold>
          </bounce>
          <contact>
            <ode><kp>50000000</kp><kd>50000</kd><max_vel>0.03</max_vel><min_depth>0.0005</min_depth></ode>
          </contact>
        </surface>
      </collision>

      <visual name="roller_visual">
        <pose>0 0 0 1.570796327 0 0</pose>
        <geometry>
          <cylinder><radius>0.025</radius><length>2.480</length></cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.10 1</ambient>
          <diffuse>0.14 0.14 0.17 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>
    </link>

    <joint name="world_fixed" type="fixed">
      <parent>world</parent><child>base</child>
    </joint>
    <joint name="shaft_joint" type="revolute">
      <parent>base</parent><child>rotor</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>400</effort><velocity>120</velocity></limit>
        <dynamics><damping>0.02</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>shaft_joint</joint_name>
      <topic>/singulator/separator/screen/cmd_vel</topic>
      <initial_velocity>80.0</initial_velocity>
    </plugin>
  </model>
</sdf>
